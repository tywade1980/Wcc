# ── Platform ──────────────────────────────────────────────────────────────
# Public base URL of this deployment (Twilio/Zoom webhooks are built from it)
PLATFORM_BASE_URL=https://wadecustomcarpentry.com
# Passcode for /office (single-operator shop). Replace with Supabase Auth later.
OFFICE_PASSCODE=change-me
# 32+ random chars, signs the office session cookie
OFFICE_SESSION_SECRET=change-me-to-a-long-random-string

# ── Company ───────────────────────────────────────────────────────────────
COMPANY_NAME="Wade Custom Carpentry"
# Where Caroline transfers callers / who gets SMS alerts (E.164)
OWNER_MOBILE=+16143597218
OWNER_NAME="Tyler Wade"
BUSINESS_TIMEZONE=America/New_York

# ── Anthropic (agents + receptionist brain) ───────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
RECEPTIONIST_MODEL=claude-opus-5

# ── Supabase (system of record) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Twilio (business line rings into the web app) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that is (or forwards from) the public business line
TWILIO_PHONE_NUMBER=
# Voice used for Caroline. Any Twilio <Say> voice id.
RECEPTIONIST_VOICE=Google.en-US-Chirp3-HD-Aoede
# Set to "true" to skip Twilio signature checks (local dev only)
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# ── Zoom Workplace (Server-to-Server OAuth app) ───────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# From the Zoom app's Feature → Event Subscriptions page
ZOOM_WEBHOOK_SECRET_TOKEN=
# Zoom user (email) whose calendar hosts client consultations
ZOOM_HOST_USER=me

# ── Google Calendar (Tyler's day) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
